{
  "name": "quote-desk",
  "private": true,
  "version": "0.1.0",
  "description": "Quote archive and builder for Sanctuary extra-works requests. Browser-only; data stays in the user's Microsoft 365 tenant.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:demo": "cross-env VITE_DEMO_ONLY=1 vite build --config vite.demo.config.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@azure/msal-browser": "^5.0.0",
    "@hello-pangea/dnd": "^18.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "cross-env": "^7.0.3",
    "playwright-core": "^1.63.0",
    "typescript": "^5.6.0",
    "vite": "^8.0.0",
    "vite-plugin-singlefile": "^2.3.0",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
